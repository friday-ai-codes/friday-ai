# Friday AI Dev Agent - Environment Configuration
# Copy this file to .env and fill in the values
#
# Quick Start:
# 1. cp .env.example .env
# 2. Fill in required values (marked with *)
# 3. docker-compose up -d
# 4. Access http://localhost:10240
# ===========================================
# Docker Compose Settings
# ===========================================
# Web frontend port (Nginx serves both frontend and proxies API)
# Access the application at http://localhost:FRIDAY_WEB_PORT
FRIDAY_WEB_PORT=10240
# Backend API port (optional, for direct API access/debugging)
# Set to empty to disable direct backend access
FRIDAY_PORT=10241
# ===========================================
# Django Core Settings
# ===========================================
# * Django Secret Key - REQUIRED in production
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key)"
SECRET_KEY=
# Debug mode (set to false in production!)
DEBUG=true
# Allowed hosts (comma-separated, use * for development only)
ALLOWED_HOSTS=localhost,127.0.0.1
# ===========================================
# Database Configuration
# ===========================================
# 支持多种数据库，格式示例：
#
# SQLite (默认，开发推荐):
# DATABASE_URL=sqlite:///./data/friday.db
#
# PostgreSQL (生产推荐，需安装 psycopg[binary]):
# DATABASE_URL=postgres://user:password@localhost:5432/friday
#
# MySQL (需安装 mysqlclient):
# DATABASE_URL=mysql://user:password@localhost:3306/friday
#
# MariaDB (需安装 mysqlclient):
# DATABASE_URL=mysql://user:password@localhost:3306/friday
DATABASE_URL=sqlite:///./data/friday.db
# ===========================================
# Security Settings
# ===========================================
# * Encryption key for sensitive data (32 bytes, base64 encoded) - REQUIRED
# Generate with one of:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key.decode)"
# openssl rand -base64 32
FRIDAY_ENCRYPTION_KEY=
# ===========================================
# CORS Settings (production)
# ===========================================
# Allowed origins for CORS (comma-separated)
# Example: https://friday.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=
# ===========================================
# JWT Settings (optional)
# ===========================================
# Custom JWT secret key (defaults to SECRET_KEY if not set)
# JWT_SECRET_KEY=
# Token expiration times
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# ===========================================
# GitHub/GitLab Integration
# ===========================================
# GitHub Webhook Secret (for verifying webhook signatures)
FRIDAY_GITHUB_WEBHOOK_SECRET=
# ===========================================
# Claude Code Integration
# ===========================================
# Anthropic API Key (for Claude Code)
# Can also be configured via Web UI (System Settings or Project Settings)
ANTHROPIC_API_KEY=
# Custom Anthropic API Base URL (optional, for proxies)
# Example: https://your-proxy.example.com/v1
# Can also be configured via Web UI (System Settings or Project Settings)
ANTHROPIC_BASE_URL=
