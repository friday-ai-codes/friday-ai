# Friday AI Dev Agent - Environment Configuration
# Copy this file to .env and fill in the values
#
# Quick Start:
# 1. cp .env.example .env
# 2. Fill in required values (marked with *)
# 3. docker-compose up -d
# 4. Access http://localhost:10241
# ===========================================
# Docker Compose Settings
# ===========================================
# Web frontend port (Nginx serves both frontend and proxies API)
# Access the application at http://localhost:FRIDAY_WEB_PORT
FRIDAY_WEB_PORT=10240
# Backend API port (optional, for direct API access/debugging)
# Set to empty to disable direct backend access
FRIDAY_PORT=10241
# ===========================================
# Application Settings
# ===========================================
# Debug mode (set to true for development)
FRIDAY_DEBUG=false
# Database URL (SQLite with async support)
# Note: In Docker, this is automatically set to use the data volume
FRIDAY_DATABASE_URL=sqlite+aiosqlite:///./data/friday.db
# * Encryption key for sensitive data (32 bytes, base64 encoded) - REQUIRED
# Generate with one of:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key.decode)"
# openssl rand -base64 32
FRIDAY_ENCRYPTION_KEY=
# ===========================================
# Feishu/Lark Integration (Optional - Project-level)
# ===========================================
# NOTE: 推荐在 Web UI 中为每个项目单独配置飞书集成
# 以下全局配置仅用于向后兼容单项目场景
# 飞书项目使用「插件」凭证而非「应用」凭证来获取工作项详情
# Feishu Plugin ID (飞书插件 ID)
# DEPRECATED: Use project-level configuration instead
FRIDAY_FEISHU_PLUGIN_ID=
# Feishu Plugin Secret (飞书插件 Secret)
# DEPRECATED: Use project-level configuration instead
FRIDAY_FEISHU_PLUGIN_SECRET=
# Feishu Webhook Verification Token
# DEPRECATED: 飞书项目使用 header.token 验证，请在项目设置中配置
FRIDAY_FEISHU_VERIFICATION_TOKEN=
# ===========================================
# GitHub Integration
# ===========================================
# GitHub Webhook Secret (for verifying webhook signatures)
FRIDAY_GITHUB_WEBHOOK_SECRET=
# ===========================================
# Claude Code Integration
# ===========================================
# * Anthropic API Key (for Claude Code) - REQUIRED for task execution
ANTHROPIC_API_KEY=
