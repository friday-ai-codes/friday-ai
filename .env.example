# Friday AI - 环境配置文件
# 使用方式:
# 方式一（推荐）: 运行 scripts/setup.sh 自动生成 .env
# 方式二: 复制本文件为 .env 并填写必填项
#
# 标记说明:
# * Required - 必填项（生产环境必须设置）
# Optional - 可选项（有合理默认值）
# ===========================================
# 本地持久化目录
# ===========================================
# Optional - Docker Compose bind mount 根目录
# setup 脚本默认会创建以下子目录:
# postgres, redis, qdrant, server, runner
FRIDAY_DATA_DIR=~/.friday-ai
# ===========================================
# Docker Compose 端口配置
# ===========================================
# Optional - Web 前端端口（Nginx 代理前端和 API）
# 访问地址: http://localhost:FRIDAY_WEB_PORT
FRIDAY_WEB_PORT=10240
# Optional - 后端 API 直接访问端口（调试用，留空则禁用）
FRIDAY_PORT=10241
# Optional - 预构建容器镜像命名空间
FRIDAY_IMAGE_PREFIX=ghcr.io/friday-ai-codes/friday-ai
# Optional - 预构建容器镜像标签
FRIDAY_IMAGE_TAG=latest
# Optional - Task 执行容器镜像（Runner 启动任务容器时使用）
# 默认: ${FRIDAY_IMAGE_PREFIX}/task:${FRIDAY_IMAGE_TAG}，Runner 会在镜像缺失时自动拉取
# 本地源码调试可设为 friday-task:latest（make build-task 构建）
# FRIDAY_TASK_IMAGE=friday-task:latest
# ===========================================
# Django 核心配置
# ===========================================
# * Required - Django Secret Key（生产环境必须设置唯一值）
# 生成方式: openssl rand -base64 32
SECRET_KEY=
# Optional - 调试模式（生产环境必须为 False）
DEBUG=False
# Optional - 允许的主机名（生产环境建议限制为实际域名）
ALLOWED_HOSTS=*
# ===========================================
# 数据库配置
# ===========================================
# * Required - 数据库连接 URL
# 内置 PostgreSQL（推荐）:
# DATABASE_URL=postgres://friday:${POSTGRES_PASSWORD:-friday}@postgres:5432/friday
# 外部 PostgreSQL:
# DATABASE_URL=postgres://db_user:db_password@db_host:5432/db_name
# 本地开发（SQLite）:
# DATABASE_URL=sqlite:///./data/friday.db
DATABASE_URL=postgres://friday:${POSTGRES_PASSWORD:-friday}@postgres:5432/friday
# ===========================================
# 数据库连接池（仅 PostgreSQL 生效，SQLite 自动忽略）
# ===========================================
# 直连 Postgres 时启用 psycopg3 应用层连接池（Django 5.1+ 原生）。高并发下避免
# 反复 connect/close。多 worker/副本时务必保证 Σ(进程数 × DB_POOL_MAX_SIZE) ≤
# Postgres max_connections；超了就改用下方 PgBouncer。
# Optional - 是否启用应用层连接池（默认 true）
DB_POOL_ENABLED=true
# Optional - 连接池最小 / 最大连接数、获取连接超时（秒）
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=30
# ===========================================
# PgBouncer（强烈推荐：多 worker / 高并发的连接池底座）
# ===========================================
# pgbouncer 已是常驻服务（docker compose up -d 自动启动）。异步 server 多进程下，
# 各自的 psycopg 应用层池在"一个页面并行打十几个接口"的突发中会被瞬间占满 →
# PoolTimeout 卡住；改走 PgBouncer transaction pooling 后，大量应用连接复用到少量
# 真实 PG 连接，根治"进程数 × 池大小"乘法爆炸。强烈建议生产启用：
#   让 web 走 pgbouncer，worker/scheduler 仍直连 postgres（取消下面三行注释）：
#        DATABASE_URL=postgres://friday:${POSTGRES_PASSWORD:-friday}@pgbouncer:6432/friday
#        DATABASE_URL_DIRECT=postgres://friday:${POSTGRES_PASSWORD:-friday}@postgres:5432/friday
#        DB_PGBOUNCER=true
#   ⚠️ worker/scheduler 必须直连（DATABASE_URL_DIRECT）：Procrastinate 依赖
#      LISTEN/NOTIFY，穿不过 PgBouncer 的 transaction pooling。
# Optional - web 是否位于 PgBouncer 之后（关闭服务端游标 + 不叠加应用层池）
# DB_PGBOUNCER=false
# Optional - worker/scheduler 直连 URL（仅在启用 PgBouncer 时需要设置）
# DATABASE_URL_DIRECT=postgres://friday:${POSTGRES_PASSWORD:-friday}@postgres:5432/friday
# Optional - PgBouncer 容量参数
# PGBOUNCER_MAX_CLIENT_CONN=1000
# PGBOUNCER_DEFAULT_POOL_SIZE=20
# PGBOUNCER_MAX_PREPARED_STATEMENTS=200
# ===========================================
# 安全与密钥配置
# ===========================================
# * Required - 数据加密密钥（32 字节，base64 编码）
# 生成方式: openssl rand -base64 32
FRIDAY_ENCRYPTION_KEY=
# * Required - Runner 注册令牌（server 和 runner 共享）
# 生成方式: openssl rand -base64 32
RUNNER_REGISTRATION_TOKEN=
# ===========================================
# 内置 PostgreSQL 配置
# ===========================================
# docker compose up -d 默认启动内置 PostgreSQL。
# Optional - PostgreSQL 用户名
POSTGRES_USER=friday
# Optional - PostgreSQL 密码
POSTGRES_PASSWORD=friday
# Optional - PostgreSQL 数据库名
POSTGRES_DB=friday
# ===========================================
# Runner 配置
# ===========================================
# Optional - Runner 名称
# FRIDAY_RUNNER_NAME=compose-runner
# Optional - Docker 组 GID（用于 runner 访问 docker.sock）
# Linux 获取方式: stat -c '%g' /var/run/docker.sock
# macOS Docker Desktop / OrbStack 通常在容器内使用 root 组
DOCKER_GID=0
# ===========================================
# JWT 认证配置
# ===========================================
# Optional - JWT 密钥（默认使用 SECRET_KEY）
# JWT_SECRET_KEY=
# Optional - Access Token 过期时间（分钟）
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Optional - Refresh Token 过期时间（天）
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional - Cookie 安全设置
# COOKIE_SECURE=False
# COOKIE_SAMESITE=Lax
# COOKIE_HTTPONLY=True
# ===========================================
# Gunicorn / 任务 Worker 并发
# ===========================================
# Optional - API 进程数（异步 UvicornWorker）。默认 1 适合小机器；多核机器提高可承载
# 更多并发请求，建议 CPU 核数的 1/4 ~ 1/2（如 16 核可设 4~8）。注意：这只提并发容量，
# 不会加快单个上游大模型调用（I/O 等待）。多进程 + 直连 Postgres 时留意连接数，见上方
# PgBouncer 一节。
# GUNICORN_WORKERS=1
# Optional - Worker 超时秒数（WebSocket/SSE 长连接需要较长超时）
# GUNICORN_TIMEOUT=300
# Optional - 单个 durable worker 进程内并发消费的 job 数（默认 4）。索引/图谱是重 IO
# 任务，串行(=1)时一次只跑一个、浪费多核；与横向多副本（docker compose up -d --scale
# worker=N）叠加放大吞吐。同样只提"并发处理任务数"，不加快单次上游模型调用。
# WORKER_CONCURRENCY=4
# ===========================================
# 代码智能 / 集成
# ===========================================
# Optional - 自托管 yapi 域名。JSDoc 中 `https://<yapi_host>/project/{pid}/interface/api/{iid}`
# 形式的接口链接会被 codegraph 解析并关联到 API 定义。默认占位 yapi.example.com，
# 设为你们自己的 yapi 域名即可（仅域名，不含协议/路径）。
# FRIDAY_YAPI_HOST=yapi.example.com
# ===========================================
# 管理员配置
# ===========================================
# 说明：首次部署的管理员账号默认由 Web「首启初始化向导」引导用户自行设置，
#       系统启动时不再自动创建管理员。以下变量仅在手动执行命令行兜底时被读取：
#         python manage.py init_superuser            # 建号，读取下面的用户名/密码（密码留空则随机生成并打印）
#         python manage.py reset_superuser_password  # 重置已有 superuser 密码
# Optional - 管理员用户名（仅供 init_superuser 命令兜底使用）
# FRIDAY_ADMIN_USERNAME=admin
# Optional - 管理员密码（仅供 init_superuser 命令兜底使用；留空则该命令随机生成密码）
# FRIDAY_ADMIN_PASSWORD=
# ===========================================
# 功能开关
# ===========================================
# Optional - 飞书同步
# FF_SYNC_WORKFLOW_TO_FEISHU=true
# Optional - WebSocket 实时更新
# FF_ENABLE_WORKFLOW_WEBSOCKET=true
# Optional - 默认工作流模板
# FF_DEFAULT_WORKFLOW_TEMPLATE=code_generation
# Optional - 启用调度器
# FF_ENABLE_SCHEDULER=true
# ===========================================
# 高级配置
# ===========================================
# Optional - 环境标识
# FRIDAY_ENV=development
# Optional - 生产模式标记
# FRIDAY_PRODUCTION=false
# Optional - 后端 API 基础 URL（容器内部通信）
# FRIDAY_BASE_URL=http://localhost:10241
# Optional - 前端 URL
# FRIDAY_FRONTEND_URL=http://localhost:10240
# Optional - 日志级别
# DJANGO_LOG_LEVEL=INFO
# Optional - Redis Channel Layer
# Compose 全包部署自带 Redis（docker-compose.yaml 注入 REDIS_URL=redis://redis:6379/0），保持 true；
# 本地裸跑 dev（make dev，无 Redis）时改为 false 退回内存实现。
USE_REDIS_CHANNEL_LAYER=true
# Optional - WebSocket TLS 要求（生产环境自动启用）
# WEBSOCKET_REQUIRE_TLS=false
# ===========================================
# 可恢复任务（断点恢复）
# ===========================================
# 真相源 = DB（Postgres/SQLite）：长任务（索引 / 图谱构建等）登记到 ResumableTask，
# 进程被 docker compose 升级、Pod 被 k8s 重建后由 RecoveryScheduler 自动续跑（断电不丢）。
# Redis 只在多副本部署时做"恢复扫描"的集群级互斥；关闭时正确性仍由 DB 行级 CAS 保证。
# Optional - 启动时自动恢复未完成任务（默认 true）
# RESUMABLE_RECOVERY_ON_STARTUP=true
# Optional - 租约 TTL / 心跳间隔（秒）；启动扫描只领取租约已过期的运行中任务
# RESUMABLE_LEASE_TTL_SECONDS=90
# RESUMABLE_HEARTBEAT_INTERVAL_SECONDS=30
# Optional - 多副本/k8s 推荐：用 Redis 做恢复扫描的集群级互斥锁（默认 false 走 DB CAS）
# RESUMABLE_USE_REDIS_LOCK=false
# Optional - 飞书集成
# FEISHU_ENCRYPT_KEY=
# FEISHU_SIGNATURE_REQUIRED=false
# ===========================================
# 邮件 SMTP（系统告警通知，ALERT-03，可选）
# ===========================================
# Optional - 留空则邮件通道关闭（告警仍落库 + 可走飞书/webhook）
# 收件人列表 / 总开关在系统设置里配（alert.email_recipients / alert.email_enabled）。
# EMAIL_HOST=smtp.feishu.cn
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Friday AI <noreply@your-domain.com>
# ===========================================
# Qdrant 向量数据库配置
# ===========================================
# Optional - Compose 内部 Qdrant URL
QDRANT_URL=http://qdrant:6333
# Optional - Qdrant HTTP 端口
# QDRANT_HTTP_PORT=6333
# Optional - Qdrant gRPC 端口
# QDRANT_GRPC_PORT=6334
# Optional - Qdrant API 密钥
# 注意：不要把它显式设为空字符串（QDRANT_API_KEY=""）。
# qdrant 只要收到该变量且值为空，就会开启"空 key 鉴权"，
# 而 server 客户端遇到空 key 不发认证头，导致健康检查报 401。
# 留空请直接保持本行注释（compose 会回落到非空默认值 friday-local，
# 两端一致即可正常工作）；scripts/setup.sh 会自动生成强随机值。
# QDRANT_API_KEY=

# ===========================================
# 代码图谱 / 索引 LSP backend 开关（）
# ===========================================
# 默认禁用 LSP，仅用 tree-sitter 抽取代码符号/图谱，
# 缓解图谱构建慢与 LSP（Volar / gopls）冷启动等待。
# 待 Volar / gopls 调好后，可显式开启对应开关重新启用（可逆，无需改代码）：
#   VOLAR_BACKEND_ENABLED=true   # Vue/TS/TSX/JS/JSX 走 Volar LSP backend
#   GOPLS_BACKEND_ENABLED=true   # Go 走 gopls LSP backend
# Optional - 默认 false（仅 tree-sitter）
# VOLAR_BACKEND_ENABLED=false
# GOPLS_BACKEND_ENABLED=false

# ===========================================
# 并发治理（）：按资源分治，不设全局总上限
# ===========================================
# 设计：
# - 索引/图谱：Procrastinate 原生 lock 槽位锁池排队，上限可配（系统设置）：
#     concurrency_index_max（默认 5）/ concurrency_graph_max（默认 3）
#   超限 job 原生留 todo 排队、worker 自动跳过；同仓恒定同槽天然串行防重复。
#   跨进程生效（DB/队列原语，非进程内信号量）：compose 单 worker 与 k8s 多 worker 均适用。
# - LLM：按 ProviderCredential.max_concurrency 凭证级限流（默认 50，0=不限）。
#   配置 Redis 时用租约信号量跨副本精确，否则进程内 fallback；超限排队 + 超时友好提示。
# - 容器（深度分析/编码）：复用 runner 的 FRIDAY_RUNNER_CONCURRENT（runner.concurrent）。
# - MCP 工具调用：不受任何并发限制。
# - 明确不设「所有任务总并发」全局硬上限。
#
# Optional - LLM 限流 Redis（留空则用进程内 fallback；多副本建议配 Redis）
# LLM_CONCURRENCY_REDIS_URL=
# Optional - 申请 LLM 并发槽位的最大等待秒数，超时返回「系统繁忙」
# LLM_CONCURRENCY_ACQUIRE_TIMEOUT_SECONDS=60
# Optional - LLM 并发槽位 Redis 租约 TTL（秒），须 > 单次 LLM 调用最长耗时
# LLM_CONCURRENCY_LEASE_TTL_SECONDS=900
# Optional - 容器并发上限（runner 注册时写入；深度分析/编码容器复用）
# FRIDAY_RUNNER_CONCURRENT=3
