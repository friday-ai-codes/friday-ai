# Friday AI Dev Agent - Environment Configuration
# Copy this file to .env and fill in the values
#
# Quick Start:
# 1. cp .env.example .env
# 2. Fill in required values (marked with *)
# 3. docker-compose up -d
# 4. Access http://localhost:10240
# ===========================================
# Docker Compose Settings
# ===========================================
# Web frontend port (Nginx serves both frontend and proxies API)
# Access the application at http://localhost:FRIDAY_WEB_PORT
FRIDAY_WEB_PORT=10240
# Backend API port (optional, for direct API access/debugging)
# Set to empty to disable direct backend access
FRIDAY_PORT=10241
# ===========================================
# Django Core Settings
# ===========================================
# * Django Secret Key - REQUIRED in production
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key)"
SECRET_KEY=
# Debug mode (set to false in production!)
DEBUG=False
# ===========================================
# Database Configuration
# ===========================================
# Docker Compose 部署（默认使用内置 PostgreSQL）:
# DATABASE_URL=postgres://friday:${POSTGRES_PASSWORD:-friday}@postgres:5432/friday
#
# Docker Compose 部署（外部数据库）:
# DATABASE_URL=postgres://user:${POSTGRES_PASSWORD}@your-host:5432/friday
#
# 本地开发（SQLite）:
# DATABASE_URL=sqlite:///./data/friday.db
DATABASE_URL=postgres://friday:${POSTGRES_PASSWORD:-friday}@postgres:5432/friday
# ===========================================
# Security Settings
# ===========================================
# * Encryption key for sensitive data (32 bytes, base64 encoded) - REQUIRED
# Generate with one of:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key.decode)"
# openssl rand -base64 32
FRIDAY_ENCRYPTION_KEY=
# ===========================================
# JWT Settings (optional)
# ===========================================
# Custom JWT secret key (defaults to SECRET_KEY if not set)
# JWT_SECRET_KEY=
# Token expiration times
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# ===========================================
# Feature Flags
# ===========================================
# When true, workflow status changes sync to Feishu
FF_SYNC_WORKFLOW_TO_FEISHU=true
# When true, WebSocket real-time updates are enabled
FF_ENABLE_WORKFLOW_WEBSOCKET=true
# Default workflow template for new tasks
FF_DEFAULT_WORKFLOW_TEMPLATE=code_generation
# ===========================================
# PostgreSQL 内置服务配置
# ===========================================
# 仅在使用 --profile postgres 启动内置数据库时生效
POSTGRES_USER=friday
POSTGRES_PASSWORD=friday
POSTGRES_DB=friday
# ===========================================
# Runner 配置
# ===========================================
# Runner 注册令牌（server 和 runner 共享，runner 启动时自动注册）
RUNNER_REGISTRATION_TOKEN=
# Runner 名称（默认: compose-runner）
# FRIDAY_RUNNER_NAME=compose-runner
# ===========================================
# Docker 配置
# ===========================================
# Docker 组 GID（用于 runner 访问 docker.sock）
# 获取方式: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
# ===========================================
# Gunicorn 配置
# ===========================================
# Worker 数量（默认 1，建议 CPU 核数 * 2 + 1）
# GUNICORN_WORKERS=1
# Worker 超时（秒，默认 300，用于 WebSocket/SSE 长连接）
# GUNICORN_TIMEOUT=300
# ===========================================
# Django 额外配置
# ===========================================
# 允许的主机名（默认 *，生产环境建议限制）
# ALLOWED_HOSTS=*
# 管理员账号（首次启动时自动创建）
# FRIDAY_ADMIN_USERNAME=admin
# FRIDAY_ADMIN_PASSWORD=
