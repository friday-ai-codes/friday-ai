{
 "extends": "@vue/tsconfig/tsconfig.dom.json",
 "include": [
 "env.d.ts",
 "src/**/*",
 "src/**/*.vue",
 "src/auto-imports.d.ts",
 "src/components.d.ts",
 "src/typed-router.d.ts"
 ],
 "exclude": [
 "src/**/__tests__/*"
 ],
 "compilerOptions": {
 "composite": true,
 "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
 "baseUrl": ".",
 "paths": {
 "~/*": ["src/*"]
 },
 "types": [
 "vite/client"
 ]
 }
}
