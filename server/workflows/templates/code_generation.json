{
  "version": "2.0",
  "name": "代码生成工作流",
  "description": "从需求到 MR 的完整代码生成流程：方案编排调研(多仓多agent) → 飞书审批 → 容器编码",
  "template_id": "code_generation",
  "nodes": [
    {
      "id": "trigger",
      "type": "manual_trigger",
      "name": "手动触发",
      "position": {"x": 400, "y": 0},
      "config": {
        "input_schema": {
          "type": "object",
          "properties": {
            "title": {"type": "string", "title": "任务标题"},
            "description": {"type": "string", "title": "需求描述"},
            "work_item_id": {"type": "string", "title": "飞书工作项ID"}
          },
          "required": ["title", "description"]
        }
      }
    },
    {
      "id": "generate_plan",
      "type": "ai_plan_research",
      "name": "AI 方案编排调研",
      "position": {"x": 400, "y": 180},
      "config": {
        "requirement_text": "## 需求\n\n**{{input.title}}**\n\n{{input.description}}",
        "include_repos": [],
        "work_item_id": ""
      }
    },
    {
      "id": "plan_approval",
      "type": "human_approval",
      "name": "方案审批",
      "position": {"x": 700, "y": 380},
      "config": {
        "mode": "plan_feishu",
        "chat_id": ""
      }
    },
    {
      "id": "ai_coding",
      "type": "ai_coding",
      "name": "AI 编码执行",
      "position": {"x": 400, "y": 580},
      "config": {
        "timeout_seconds": 1800,
        "chat_id": ""
      }
    },
    {
      "id": "create_doc",
      "type": "feishu_doc_create",
      "name": "生成交付文档",
      "position": {"x": 400, "y": 780},
      "config": {
        "title": "[技术方案] {{nodes.generate_plan.plan.title}}",
        "content": "{{nodes.generate_plan.plan.summary}}",
        "folder_token": ""
      }
    },
    {
      "id": "notify_result",
      "type": "notify_feishu_im",
      "name": "通知编码结果",
      "position": {"x": 400, "y": 980},
      "config": {
        "receive_id_type": "chat_id",
        "receive_id": "",
        "message_type": "card",
        "title": "AI 编码完成通知",
        "content": "AI 编码已完成。\n\n方案文档：{{nodes.create_doc.document_url}}"
      }
    }
  ],
  "edges": [
    {"source": "trigger", "target": "generate_plan"},
    {"source": "generate_plan", "target": "plan_approval"},
    {"source": "plan_approval", "target": "ai_coding", "source_handle": "approved"},
    {"source": "plan_approval", "target": "generate_plan", "source_handle": "rejected", "label": "驳回修改"},
    {"source": "ai_coding", "target": "create_doc", "source_handle": "default"},
    {"source": "create_doc", "target": "notify_result", "source_handle": "default"}
  ]
}
