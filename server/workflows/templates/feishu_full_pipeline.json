{
 "version": "1.0",
 "name": "飞书全链路自动化",
 "description": "飞书工作项状态变更触发 → 获取需求详情 → AI 方案生成 → 飞书审批 → 容器编码(含 MR) → AI 代码审查",
 "template_id": "feishu_full_pipeline",
 "nodes": [
 {
 "id": "trigger",
 "type": "feishu_event_trigger",
 "name": "飞书事件触发",
 "position": {"x": 400, "y": 0},
 "config": {
 "event_type": "work_item_status_changed",
 "filter_work_item_type": "",
 "filter_status":
 }
 },
 {
 "id": "fetch_work_item",
 "type": "fetch_work_item",
 "name": "获取工作项详情",
 "position": {"x": 400, "y": 140},
 "config": {
 "work_item_id": "{{input.work_item_id}}",
 "work_item_type": ""
 }
 },
 {
 "id": "generate_plan",
 "type": "ai_plan_generation",
 "name": "AI 方案生成",
 "position": {"x": 400, "y": 280},
 "config": {
 "user_prompt": "## 需求\n\n**{{nodes.fetch_work_item.name}}**\n\n{{nodes.fetch_work_item.description}}"
 }
 },
 {
 "id": "plan_approval",
 "type": "ai_plan_approval",
 "name": "方案审批",
 "position": {"x": 400, "y": 420},
 "config": {
 "chat_id": ""
 }
 },
 {
 "id": "ai_coding",
 "type": "ai_coding",
 "name": "AI 编码执行",
 "position": {"x": 400, "y": 560},
 "config": {
 "container_image": "friday/claude-code:latest",
 "timeout_seconds": 1800,
 "chat_id": ""
 }
 },
 {
 "id": "code_review",
 "type": "ai_code_review",
 "name": "AI 代码审查",
 "position": {"x": 400, "y": 700},
 "config": {
 "chat_id": ""
 }
 }
 ],
 "edges": [
 {"source": "trigger", "target": "fetch_work_item"},
 {"source": "fetch_work_item", "target": "generate_plan"},
 {"source": "generate_plan", "target": "plan_approval"},
 {"source": "plan_approval", "target": "ai_coding", "source_handle": "approved"},
 {"source": "plan_approval", "target": "generate_plan", "source_handle": "rejected", "label": "驳回修改"},
 {"source": "ai_coding", "target": "code_review"}
 ]
}
