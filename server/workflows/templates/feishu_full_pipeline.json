{
  "version": "1.0",
  "name": "飞书全链路自动化",
  "description": "飞书工作项状态变更触发 → 获取需求详情 → AI 方案生成 → 飞书审批 → 容器编码(含 MR)",
  "template_id": "feishu_full_pipeline",
  "nodes": [
    {
      "id": "trigger",
      "type": "feishu_event_trigger",
      "name": "飞书事件触发",
      "position": {"x": 400, "y": 0},
      "config": {
        "event_type": "WorkitemStatusEvent",
        "filter_work_item_type": "",
        "filter_status": []
      }
    },
    {
      "id": "fetch_work_item",
      "type": "fetch_work_item",
      "name": "获取工作项详情",
      "position": {"x": 400, "y": 160},
      "config": {
        "work_item_id": "{{input.work_item_id}}",
        "work_item_type": ""
      }
    },
    {
      "id": "generate_plan",
      "type": "ai_plan_generation",
      "name": "AI 方案生成",
      "position": {"x": 400, "y": 340},
      "config": {
        "user_prompt": "## 需求\n\n**{{nodes.fetch_work_item.name}}**\n\n{{nodes.fetch_work_item.description}}"
      }
    },
    {
      "id": "plan_approval",
      "type": "human_approval",
      "name": "方案审批",
      "position": {"x": 700, "y": 540},
      "config": {
        "mode": "plan_feishu",
        "chat_id": ""
      }
    },
    {
      "id": "ai_coding",
      "type": "ai_coding",
      "name": "AI 编码执行",
      "position": {"x": 400, "y": 740},
      "config": {
        "timeout_seconds": 1800,
        "chat_id": ""
      }
    },
    {
      "id": "create_doc",
      "type": "feishu_doc_create",
      "name": "生成交付文档",
      "position": {"x": 400, "y": 940},
      "config": {
        "title": "[技术方案] {{nodes.generate_plan.plan.title}}",
        "content": "{{nodes.generate_plan.final_answer}}",
        "folder_token": ""
      }
    },
    {
      "id": "notify_result",
      "type": "notify_feishu_im",
      "name": "通知编码结果",
      "position": {"x": 400, "y": 1140},
      "config": {
        "receive_id_type": "chat_id",
        "receive_id": "",
        "message_type": "card",
        "title": "AI 编码完成通知",
        "content": "AI 编码已完成。\n\n方案文档：{{nodes.create_doc.document_url}}"
      }
    }
  ],
  "edges": [
    {"source": "trigger", "target": "fetch_work_item"},
    {"source": "fetch_work_item", "target": "generate_plan"},
    {"source": "generate_plan", "target": "plan_approval"},
    {"source": "plan_approval", "target": "ai_coding", "source_handle": "approved"},
    {"source": "plan_approval", "target": "generate_plan", "source_handle": "rejected", "label": "驳回修改"},
    {"source": "ai_coding", "target": "create_doc", "source_handle": "default"},
    {"source": "create_doc", "target": "notify_result", "source_handle": "default"}
  ]
}
