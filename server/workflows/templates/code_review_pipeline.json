{
  "version": "1.0",
  "name": "PR 代码审查",
  "description": "Webhook 触发 → AI 多维度审查 → 飞书通知结果。\n\n触发前提（方案 A 结构性契约）：Webhook payload 须携带编码结果数据，形态为 coding_result: {merge_requests: [{mr_id, repository_id, repository_name, mr_url}]}，并直接送入 AI 代码审查节点的 coding_result 输入端口。其中 repository_id 必须是 Friday 中已注册仓库的 UUID，且该仓库已配置访问凭证——审查节点据此拉取 diff，外部 PR 审查无法仅靠节点 config 自足。可由上游 ai_coding 流程或外部系统按上述形态投递 Webhook 实现 PR 提交自动审查。",
  "template_id": "code_review_pipeline",
  "nodes": [
    {
      "id": "trigger",
      "type": "webhook_trigger",
      "name": "PR Webhook 触发",
      "position": {"x": 400, "y": 0},
      "config": {
        "secret": "",
        "method": "POST"
      }
    },
    {
      "id": "review",
      "type": "ai_code_review",
      "name": "AI 代码审查",
      "position": {"x": 400, "y": 220},
      "config": {
        "model": "",
        "chat_id": "",
        "max_iterations": 30
      }
    },
    {
      "id": "notify",
      "type": "notify_feishu",
      "name": "通知审查结果",
      "position": {"x": 400, "y": 440},
      "config": {
        "webhook_url": "",
        "message_type": "text",
        "content": "PR 审查完成：{{nodes.review.review_report}}",
        "title": "",
        "at_all": false,
        "at_users": []
      }
    }
  ],
  "edges": [
    {"source": "trigger", "target": "review", "target_handle": "coding_result"},
    {"source": "review", "target": "notify"}
  ]
}
